# ====== Aplikasi ======
APP_PORT=8080
# Akun admin dibuat otomatis saat pertama kali jalan (GANTI password ini!)
ADMIN_EMAIL=admin@students.unnes.ac.id
ADMIN_PASSWORD=ganti-password-admin
# Domain email yang boleh mendaftar (pisahkan koma). Untuk uji coba bisa tambah gmail.com
ALLOWED_DOMAINS=students.unnes.ac.id
# link = tautan verifikasi ditampilkan di layar (mudah untuk demo)
# mail = dikirim lewat mail() PHP (butuh SMTP/sendmail)
VERIFY_MODE=link
APP_URL=
MAIL_FROM=no-reply@localhost
PROMO_PAYMENT_INFO=Transfer ke rekening/QRIS admin lalu kirim bukti bayar lewat chat atau WhatsApp admin. Promosi aktif setelah dikonfirmasi.

# ====== Database ======
DB_NAME=preloved_unnes
DB_USER=preloved_unnes
DB_PASS=*&sudahmalamAtausudahTahu*&
DB_ROOT_PASS=*&sudahmalamAtausudahTahu*&
